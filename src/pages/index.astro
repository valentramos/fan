---
import { Cards } from "@/components/Cards";
import Layout from "../layouts/Layout.astro";
import { Button } from "@/components/ui/button";
import { Card } from "@/components/ui/card";
import {
  Table,
  TableBody,
  TableCaption,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";
import {
  Carousel,
  CarouselContent,
  CarouselItem,
  CarouselNext,
  CarouselPrevious,
} from "@/components/ui/carousel";
import { CardHeader, CardTitle, CardContent } from "@/components/ui/card";
import { Fragment } from "react";
import {
  QrCode,
  WifiOff,
  CheckCircle2,
  Clock,
  LogIn,
  BarChart2,
  Ticket,
  Users,
  ShoppingBag,
} from "lucide-react";
---

<Layout
  title="+FAN"
  description="La solución completa para gestionar eventos, vender entradas y fidelizar clientes bajo tu propia marca"
  keywords="gestión eventos, ticketing, venta entradas, control accesos, marca blanca, fidelización"
  image="/sales.jpg"
>
  <section
    class="w-full h-screen relative flex items-center justify-center bg-cover bg-no-repeat bg-center bg-fixed"
    style="background-image: url('https://www.totalisimo.com/wp-content/uploads/2018/08/tecnologias-control-acceso.jpg');"
  >
    <div class="absolute inset-0 bg-blue-950/60 backdrop-blur-sm"></div>

    <div class="relative text-center lg:px-32 px-2">
      <h1
        class="text-white lg:text-5xl text-3xl mb-6 font-bold drop-shadow-lg animate-fade-in-up animate-delay-300"
      >
        Conecta, vende y fideliza con tu propio ecosistema digital
      </h1>
      <p
        class="text-white text-xl mb-8 drop-shadow animate-fade-in-up animate-delay-600 lg:px-24"
      >
        Gestiona membresías, tickets, accesos y contenido exclusivo desde una
        plataforma integral.
      </p>
      <div
        class="flex flex-col sm:flex-row gap-4 justify-center animate-fade-in-up animate-delay-900"
      >
        <!-- <Button size="lg">
          <a href="https://wa.link/gakigu" target="_blank">Visitar Demo</a>
        </Button> -->
        <Button size="lg" variant="secondary">
          <a href="https://wa.link/dk5urn" target="_blank">Contactar</a>
        </Button>
      </div>
    </div>
  </section>

  <section class="py-16 bg-gradient-to-r from-sky-900 to-blue-950">
    <div class="container mx-auto">
      <div class="text-center lg:px-32">
        <h5 class="text-white lg:text-lg font-bold">
          Presentamos: <span class="text-[#06E3F4]">+</span>FAN
        </h5>
        <h1 class="text-white text-2xl lg:mb-8 font-bold">
          El ecosistema integral para eventos deportivos y sociales
        </h1>
        <p class="text-white text-lg mb-8 font-light">
          +FAN es un ecosistema modular y white-label para la gestión de eventos
          deportivos y sociales. Centraliza ventas, CRM, acceso y fidelización
          en una experiencia fluida y personalizada bajo tu propia marca.
        </p>
        <img src="/mindmap.png" class="py-10 mx-auto" />
      </div>
    </div>
  </section>

  <section class="lg:py-24 py-16">
    <div class="container mx-auto">
      <div class="grid lg:grid-cols-2 gap-20 items-center justify-center">
        <div>
          <img src="/ticketing/admin-4.png" class="animated-banner" />
        </div>
        <div class="space-y-4">
          <h1 class="text-2xl lg:mb-10 font-bold text-[#013B79]">
            Plataforma de Ticketing White-Label
          </h1>
          <div class="grid grid-cols-[25px_1fr] items-start">
            <span class="flex h-2 w-2 translate-y-2 rounded-full bg-primary"
            ></span>
            <p class="text-gray-600 font-light">
              <span class="font-medium text-[#013B79]"
                >Recaudación directa y diaria:</span
              >
              Recibe tus pagos cada día directamente en tu cuenta bancaria, sin intermediarios
              ni esperas.
            </p>
          </div>
          <div class="grid grid-cols-[25px_1fr] items-start">
            <span class="flex h-2 w-2 translate-y-2 rounded-full bg-primary"
            ></span>
            <p class="text-gray-600 font-light">
              <span class="font-medium text-[#013B79]"
                >Control de accesos robusto:</span
              >
              Sistema de validación online/offline con tecnología QR y NFC para eventos
              masivos.
            </p>
          </div>
          <div class="grid grid-cols-[25px_1fr] items-start">
            <span class="flex h-2 w-2 translate-y-2 rounded-full bg-primary"
            ></span>
            <p class="text-gray-600 font-light">
              <span class="font-medium text-[#013B79]"
                >Múltiples medios de pago:</span
              >
              Integración con las principales pasarelas de pago y billeteras digitales
              del mercado.
            </p>
          </div>
          <div class="grid grid-cols-[25px_1fr] items-start">
            <span class="flex h-2 w-2 translate-y-2 rounded-full bg-primary"
            ></span>
            <p class="text-gray-600 font-light">
              <span class="font-medium text-[#013B79]"
                >Analytics en tiempo real:</span
              >
              Reportes detallados de ventas, asistencia y comportamiento de usuarios.
            </p>
          </div>
          <div class="mt-8">
            <Button variant="secondary" size="lg">
              <a href="/ticketing">Conocer más</a>
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container mx-auto">
      <div class="grid lg:grid-cols-2 gap-20 items-center justify-center">
        <div class="order-2 lg:order-1">
          <div class="space-y-4">
            <h1 class="text-2xl lg:mb-10 font-bold text-[#013B79]">
              Ecosistema de Fidelización
            </h1>
            <div class="grid grid-cols-[25px_1fr] items-start">
              <span class="flex h-2 w-2 translate-y-2 rounded-full bg-[#06E3F4]"
              ></span>
              <p class="text-gray-600 font-light">
                <span class="font-medium text-[#013B79]"
                  >Programa de membresías:</span
                >
                Sistema completo de beneficios y recompensas para fidelizar a tus
                clientes.
              </p>
            </div>
            <div class="grid grid-cols-[25px_1fr] items-start">
              <span class="flex h-2 w-2 translate-y-2 rounded-full bg-[#06E3F4]"
              ></span>
              <p class="text-gray-600 font-light">
                <span class="font-medium text-[#013B79]"
                  >E-commerce integrado:</span
                >
                Venta de productos oficiales y merchandising directamente en tu plataforma.
              </p>
            </div>
            <div class="grid grid-cols-[25px_1fr] items-start">
              <span class="flex h-2 w-2 translate-y-2 rounded-full bg-[#06E3F4]"
              ></span>
              <p class="text-gray-600 font-light">
                <span class="font-medium text-[#013B79]"
                  >CRM especializado:</span
                >
                Gestión integral de tu base de datos con segmentación avanzada.
              </p>
            </div>
            <div class="grid grid-cols-[25px_1fr] items-start">
              <span class="flex h-2 w-2 translate-y-2 rounded-full bg-[#06E3F4]"
              ></span>
              <p class="text-gray-600 font-light">
                <span class="font-medium text-[#013B79]"
                  >Contenido exclusivo:</span
                >
                Área privada para contenido premium y beneficios especiales.
              </p>
            </div>
            <div class="mt-8">
              <Button size="lg" variant="secondary">
                <a href="/comunidad">Conocer más</a>
              </Button>
            </div>
          </div>
        </div>
        <div class="order-1 lg:order-2">
          <img src="/banner-2.png" class="animated-banner" />
        </div>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-2xl lg:mb-4 font-bold text-[#013B79]">
          Casos de éxito
        </h2>
        <p class="text-gray-600 lg:px-48">
          Organizaciones que ya confían en nuestra plataforma para gestionar sus
          eventos y comunidades
        </p>
      </div>
      <div class="lg:flex gap-10 lg:px-40 items-center">
        <img src="/bolivar-icon.png" class="m-auto w-32" />
        <div>
          <h5 class="text-[#013B79] font-light text-xl mt-5 lg:mt-0">
            "<span class="text-[#06E3F4]">+</span>FAN es una plataforma integral
            que ayuda a gestionar en un solo lugar la venta de entradas, venta
            de productos, generar contenido de valor y dar esa recompensa al
            hincha fiel."
          </h5>
          <p class="text-gray-500 mt-2">Club Bolívar - División Profesional</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container mx-auto">
      <Card
        className="w-full max-w-5xl mx-auto p-0 overflow-hidden shadow-lg border-0 relative"
        style={{
          background: "linear-gradient(66deg, #013b7900 30%, #06E3F4 100%)",
        }}
      >
        <div class="absolute inset-0 bg-white/70 pointer-events-none"></div>
        <div class="flex flex-col lg:flex-row items-center relative z-10">
          <div class="flex-1 p-10">
            <h2 class="text-3xl font-bold text-[#013B79] mb-4">
              ¿Listo para transformar tus eventos?
            </h2>
            <p class="text-gray-700 mb-8">
              Agenda una demo personalizada y descubre cómo +FAN puede ayudarte
              a vender más entradas y fidelizar a tus clientes.
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
              <Button size="lg" className="bg-[#013B79] hover:bg-[#013B79]/90">
                <a href="https://wa.link/dk5urn" target="_blank"
                  >Contactar agente</a
                >
              </Button>
              <!-- <Button variant="outline" size="lg">
                <a href="https://wa.me/59178400000" target="_blank"
                  >Contactar por WhatsApp</a
                >
              </Button> -->
            </div>
          </div>
          <div class="flex-1 flex justify-center items-center p-10">
            <img src="/favicon.svg" class="mr-3 w-48" alt="Fan Logo" />
          </div>
        </div>
      </Card>
    </div>
  </section>
</Layout>
